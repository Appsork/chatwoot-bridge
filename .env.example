# Chatwoot connection
CHATWOOT_URL=http://your-chatwoot-address:3000
CHATWOOT_API_TOKEN=your_chatwoot_agent_token
CHATWOOT_ACCOUNT_ID=1

# LLM connection (any OpenAI-compatible endpoint: Ollama, OpenAI, DeepSeek, etc.)
LLM_API_BASE=http://your-llm-endpoint:11434
LLM_API_KEY=sk-anything-or-blank
LLM_MODEL=your_model_name

# Embeddings
EMBEDDING_MODEL=nomic-embed-text

# Memory storage (separate database on the same Postgres server Chatwoot uses)
VECTOR_DB_URL=postgresql://user:pass@postgres:5432/rag_memory

# Generic API channel source (channel_sources/generic_api.py) - config-driven,
# works against any simple GET-a-JSON-list API with optional header auth.
# Example below targets HN's public Algolia search API (no auth needed);
# point it at any other JSON API by changing these values, no code changes.
GENERIC_API_SOURCE_NAME=hn
GENERIC_API_URL=https://hn.algolia.com/api/v1/search_by_date?tags=story
GENERIC_API_AUTH_HEADER=
GENERIC_API_AUTH_VALUE=
GENERIC_API_ITEMS_PATH=hits
GENERIC_API_ID_FIELD=objectID
GENERIC_API_AUTHOR_FIELD=author
GENERIC_API_TEXT_FIELD=title
GENERIC_API_URL_FIELD=url
# Reply support is optional - leave blank for read-only sources like HN's search API.
GENERIC_API_REPLY_URL=
GENERIC_API_REPLY_TEXT_FIELD=text
# Where the last-seen-item checkpoint is stored (repo-relative path or absolute).
GENERIC_API_CHECKPOINT_PATH=var/channel_source_checkpoints.json
